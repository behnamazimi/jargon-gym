{
  "name": "lobyas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "scripts/widget-zip.sh && next build",
    "start": "next start",
    "lint": "oxlint --fix .",
    "knip": "knip",
    "type-check": "tsc --noEmit",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm run lint && pnpm run fmt:check && pnpm run type-check && pnpm run knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "widget:zip": "WIDGET_PRODUCTION_URL=https://lobyas.com scripts/widget-zip.sh",
    "widget:install": "LOBYAS_BASE_URL=${LOBYAS_BASE_URL:-https://lobyas.com} scripts/widget-install.sh",
    "widget:link": "scripts/widget-link.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.47",
    "@ai-sdk/google": "^4.0.24",
    "@ai-sdk/otel": "^1.0.114",
    "@aws-sdk/client-s3": "^3.1126.0",
    "@elevenlabs/elevenlabs-js": "^2.66.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.11",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@posthog/ai": "^8.13.4",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.112.4",
    "@types/mdx": "^2.0.14",
    "ai": "^7.0.114",
    "clsx": "^2.1.1",
    "entities": "8.0.0",
    "lucide-react": "^1.52.0",
    "next": "16.2.11",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.75.0",
    "papaparse": "^5.7.0",
    "posthog-js": "^1.435.9",
    "posthog-node": "^5.55.0",
    "react": "19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.8",
    "resend": "^6.22.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "daisyui": "^5.7.22",
    "esbuild": "^0.28.2",
    "knip": "^6.32.2",
    "pg": "^8.23.1",
    "serwist": "^9.5.12",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@8.15.0"
}
