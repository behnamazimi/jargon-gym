{
  "name": "jargon-gym",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "scripts/widget-zip.sh && next build",
    "start": "next start",
    "lint": "oxlint --fix .",
    "knip": "knip",
    "type-check": "tsc --noEmit",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm run lint && pnpm run fmt:check && pnpm run type-check",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "widget:zip": "WIDGET_PRODUCTION_URL=https://jargon-gym.vercel.app scripts/widget-zip.sh",
    "widget:install": "JARGON_WIDGET_TOKEN=aM5hpFZdq699yoEnYiPuSCB_UNSPLwjeTgn8DSdhtxw JARGON_BASE_URL=https://jargon-gym.vercel.app scripts/widget-install.sh",
    "widget:link": "scripts/widget-link.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.21",
    "@ai-sdk/google": "^4.0.24",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "ai": "^7.0.37",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "react": "19.2.4",
    "react-aria-components": "^1.19.0",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "daisyui": "^5.7.4",
    "knip": "^6.29.0",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
