# Copy to .env.local and fill from `pnpm supabase:status` (local)
# or from your Supabase project settings (remote).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — from `pnpm supabase:status` (service_role key) or Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Server-only — 32+ character secret for encrypting LLM API keys at rest.
LLM_SETTINGS_ENCRYPTION_KEY=

# Baked into widget zip and install script during `pnpm build` / `pnpm widget:zip`.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically if this is unset.
WIDGET_PRODUCTION_URL=

# Telegram bot (Next.js settings deep links + Edge Functions)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CRON_SECRET=
# Shared secret: Edge Functions → Next.js internal Telegram API routes.
TELEGRAM_INTERNAL_SECRET=
# Secret for the narration sync route: the app's own kick and the Supabase cron
# job that calls it. Use a different value from TELEGRAM_INTERNAL_SECRET; see
# docs/supabase/narration-sync-cron.md.
AI_INTERNAL_SECRET=
# Public app URL for auth redirects (OAuth, password reset) and Edge→Next Telegram proxy.
# Must be reachable from Supabase Edge (local: use a tunnel URL).
APP_BASE_URL=

# Server-only — Resend API key for sending invite emails (resend.com dashboard).
RESEND_API_KEY=

# Server-only — Murf API key for narration, the primary provider (murf.ai API dashboard).
MURF_API_KEY=

# Server-only — ElevenLabs API key for narration, the fallback provider (elevenlabs.io dashboard).
ELEVENLABS_API_KEY=

# Server-only — Supabase Storage's S3-compatible protocol, used to upload/sign
# narration audio (Supabase dashboard: Project Settings > Storage > S3 Connection).
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=term-narrations

# Server-only — the app's own AI key, used for AI quizzes and Stories by accounts
# that haven't saved a key of their own (they spend AI credits). Leave the key
# empty to switch AI credits off. Provider is "google" (default) or "anthropic".
CENTRAL_LLM_PROVIDER=google
CENTRAL_LLM_API_KEY=

# Server-only — Vercel AI Gateway key, used for term evaluation (admin only).
# Not needed on Vercel when the deployment authenticates the Gateway itself.
AI_GATEWAY_API_KEY=

# PostHog Configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
# Point this at your reverse-proxy subdomain once it is set up.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
# Server-side events and traces go straight to PostHog, not through the proxy.
POSTHOG_SERVER_HOST=https://eu.i.posthog.com
